PORT=3000

NODE_ENV=development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Порог пригодности окна для наружных работ: осадков быть не должно,
# скорость ветра должна быть строго ниже этого значения (км/ч)
WEATHER_MAX_WIND_KMH=40

BODY_LIMIT=100kb

LOG_LEVEL=info

API_KEYS=

PGHOST=localhost
PGPORT=5432
PGDATABASE=equipment_maintenance
PGUSER=app
PGPASSWORD=

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
