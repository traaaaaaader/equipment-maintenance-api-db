PORT=3000

NODE_ENV=development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Порог пригодности окна для наружных работ: осадков быть не должно,
# скорость ветра должна быть строго ниже этого значения (км/ч)
WEATHER_MAX_WIND_KMH=40

BODY_LIMIT=100kb

LOG_LEVEL=info

API_KEYS=

PGHOST=localhost
PGPORT=5432
PGDATABASE=equipment_maintenance
# Отдельная база для автотестов (npm test) — не пересекается с dev-данными
PGDATABASE_TEST=equipment_maintenance_test

# Привилегированная роль (суперпользователь кластера Postgres в контейнере — так
# инициализирует POSTGRES_USER официальный образ postgres). Используется только
# миграциями/сидами (sequelize-cli) и тестами (нужен TRUNCATE) — не рантайм-соединением API.
# Непустой пароль обязателен: без него контейнер postgres вообще не запустится.
PGUSER=app
PGPASSWORD=dev_local_password

# Непривилегированная роль для рантайм-соединения самого API (dev/prod) — только
# SELECT/INSERT/UPDATE/DELETE по таблицам приложения, без CREATEDB/DDL. Создаётся
# автоматически при первой инициализации контейнера БД (db/init/10-create-app-runtime-role.sh).
APP_PGUSER=app_runtime
APP_PGPASSWORD=dev_local_runtime_password

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
