            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized attempt\",\n  \"type\": \"sensor\",\n  \"serialNumber\": \"SN-UNAUTH-{{$randomInt}}\",\n  \"location\": {\n    \"lat\": 0,\n    \"lon\": 0\n  },\n  \"installedAt\": \"2023-01-01\"\n}"
            }
