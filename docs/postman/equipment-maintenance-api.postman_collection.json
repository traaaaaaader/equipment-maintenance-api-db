            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine A1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-{{$randomInt}}-{{$timestamp}}\",\n  \"location\": {\n    \"lat\": 55.75,\n    \"lon\": 37.61\n  },\n  \"installedAt\": \"2023-01-01\"\n}"
