        {
          "name": "Rate limit burst — expects 429",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Pre-request забивает лимит пачкой запросов (rateLimitMax + 10) перед основным. Если у вас RATE_LIMIT_MAX больше 100 на сервере — поправьте rateLimitMax в окружении."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const total = parseInt(pm.environment.get('rateLimitMax') || '100', 10) + 10;",
                  "let sent = 0;",
                  "function fireNext(done) {",
                  "  if (sent >= total) return done();",
                  "  sent++;",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/health', method: 'GET' }, function () {",
                  "    fireNext(done);",
                  "  });",
                  "}",
                  "setTimeout(function () { fireNext(function () {}); }, 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 429', function () {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "pm.test('429 exposes rate limit headers', function () {",
                  "  if (pm.response.code === 429) {",
                  "    pm.expect(pm.response.headers.has('RateLimit')).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
