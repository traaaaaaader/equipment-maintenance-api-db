        {
          "name": "DELETE /api/equipment/:id — conflict, has open requests (409)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", "{{equipmentId}}"]
            },
            "description": "Прогоняет заявку через API прямо перед проверкой, чтобы у equipmentId гарантированно была открытая заявка."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "await pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/api/requests',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json', 'X-API-Key': pm.environment.get('apiKey') },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ equipmentId: pm.environment.get('equipmentId'), title: 'Guard request for delete conflict check', priority: 'low' }) }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('error.code is CONFLICT', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/requests/:id/status — invalid transition (409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{transitionCheckRequestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "{{transitionCheckRequestId}}", "status"]
            },
            "description": "Заводит собственную заявку и переводит её в rejected, из которого переходов больше нет — не завязано на requestId из папки Requests, тот к этому моменту уже удалён.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const created = await pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/api/requests',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json', 'X-API-Key': pm.environment.get('apiKey') },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ equipmentId: pm.environment.get('equipmentId'), title: 'Guard request for invalid transition check', priority: 'low' }) }",
                  "});",
                  "const guardId = created.json().data.id;",
                  "",
                  "await pm.sendRequest({",
                  "  url: pm.environment.get('baseUrl') + '/api/requests/' + guardId + '/status',",
                  "  method: 'PATCH',",
                  "  header: { 'Content-Type': 'application/json', 'X-API-Key': pm.environment.get('apiKey') },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ status: 'rejected' }) }",
                  "});",
                  "",
                  "pm.environment.set('transitionCheckRequestId', guardId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('error.code is CONFLICT', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/equipment — missing X-API-Key (401, bonus auth)",
