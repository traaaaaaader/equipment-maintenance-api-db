    "name": "CaseLab · Кейс 2 — Учёт заявок на обслуживание оборудования",
    "description": "Покрывает health, equipment и requests. Запросы сохраняют id созданных сущностей в переменные окружения и переиспользуют их дальше по коллекции, поэтому папки нужно гонять по порядку сверху вниз (Collection Runner или вручную).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Content-Type is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('has X-Request-Id header', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-Id')).to.exist;",
                  "});",
                  "pm.test('data.status is ok', function () {",
                  "  pm.expect(pm.response.json().data.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
