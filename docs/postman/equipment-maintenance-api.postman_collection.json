    {
      "name": "Negative & security scenarios",
      "item": [
        {
          "name": "POST /api/equipment — validation error (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            },
            "description": "Короткое name, невалидный type, нет обязательных полей.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"type\": \"not-a-type\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('error body has unified shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.have.all.keys('code', 'message', 'requestId', 'details');",
                  "});",
                  "pm.test('error.code is VALIDATION_ERROR', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});",
                  "pm.test('details list the invalid fields', function () {",
                  "  pm.expect(pm.response.json().error.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
